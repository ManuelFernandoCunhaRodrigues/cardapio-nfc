{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "salgae-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "salgae-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "salgae-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=apps/api/.env", "apps/api/dist/server.js"],
      "port": 4000
    }
  ]
}
