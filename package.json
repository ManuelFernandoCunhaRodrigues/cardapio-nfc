{
  "name": "salgae",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @salgae/web --",
    "build": "npm run build -w @salgae/web",
    "start": "npm run start -w @salgae/web --",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @salgae/web --",
    "test:db": "bash scripts/testar-banco-local.sh",
    "test:types-db": "tsc --noEmit -p tsconfig.tipos-do-banco.json",
    "icones:gerar": "npm run icones:gerar -w @salgae/web",
    "qr:gerar": "npm run qr:gerar -w @salgae/web --",
    "qr:verificar": "npm run qr:verificar -w @salgae/web --"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
