{
  "name": "@salgae/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embedded": "./src/embedded.ts",
    "./modules/media/video/ffmpeg-asset": "./src/modules/media/video/ffmpeg-asset.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@salgae/core": "*",
    "@supabase/supabase-js": "2.119.2",
    "ffmpeg-static": "5.3.0",
    "hono": "4.13.19",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.36.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
