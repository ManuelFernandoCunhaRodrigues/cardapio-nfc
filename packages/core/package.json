{
  "name": "@salgae/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts/*": "./src/contracts/*.ts",
    "./contracts/*.test": null,
    "./database/*": "./src/database/*.ts",
    "./rules/*": "./src/rules/*.ts",
    "./rules/*.test": null,
    "./schemas/*": "./src/schemas/*.ts",
    "./schemas/*.test": null
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.36.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
